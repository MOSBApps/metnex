# Metnex API — local development environment template
# Bu dosya dev.sh tarafından .env olarak üretilir.

NODE_ENV=development
PORT=3001

# TASK-027.55 — opt-in, deterministic, in-memory reporting simulation data for the analysis screen.
# Requires BOTH NODE_ENV=development AND this exact value; never active in production regardless
# of this flag (see apps/api/src/reporting/dataset/dev-fixture-dataset.provider.ts). Never writes
# anything to the database.
# REPORTING_DEV_FIXTURES=true
# Development CSV snapshot fixture source time zone (IANA; dev override only, never a catalog verification).
# ./dev.sh writes both lines for local development (default Europe/Istanbul).
# REPORTING_DEV_FIXTURE_SOURCE_TIMEZONE=Europe/Istanbul
# Registry-free development data scope for the SCADA fixture API ONLY (TASK-027.73-R4). Effective only with NODE_ENV=development,
# REPORTING_DEV_FIXTURES=true and a valid zone; never in production; guards still apply; writes nothing.
# REPORTING_DEV_FIXTURE_SCOPE_BRIDGE=true

DATABASE_URL=postgresql://metnex:metnex_dev_2026@127.0.0.1:5433/metnex
REDIS_URL=redis://:redis_dev_2026@127.0.0.1:6379

JWT_SECRET=dev-only-not-for-production-min-64-chars-padding-padding-padding-xx
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ALLOWED_ORIGINS=http://localhost:3000

SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=StrongPass1!
SYSTEM_ADMIN_DISPLAY_NAME=System Administrator

# Report renderer (optional — internal-only Jasper HTTP renderer, services/jasper-renderer/).
# Unset by default: exports use the in-process PDF/XLSX fallback, no Jasper required.
# ./dev.sh builds/starts the renderer and writes these three automatically — you normally don't
# set them by hand locally. REPORT_RENDER_INTERNAL_TOKEN becomes mandatory once
# REPORT_RENDER_ENDPOINT is set — the API fails closed rather than calling the renderer
# unauthenticated. See docs/runbooks/reporting-foundation.md for the full HTTP contract.
# REPORT_RENDER_ENDPOINT=http://127.0.0.1:8088/render
# REPORT_RENDER_INTERNAL_TOKEN=
# REPORT_RENDER_TIMEOUT_MS=15000

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="default-report" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <!-- Bean-fed only (JRBeanCollectionDataSource) — no queryString element, no JDBC connection
         is ever passed to JasperFillManager.fillReport() for this template. -->

    <parameter name="ARTIFACT_TITLE" class="java.lang.String"/>

    <field name="no" class="java.lang.String"/>
    <field name="label" class="java.lang.String"/>
    <field name="occurredAt" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="amount" class="java.math.BigDecimal"/>

    <title>
        <band height="36">
            <textField>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement>
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ARTIFACT_TITLE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="60" height="20"/>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement x="60" y="0" width="150" height="20"/>
                <text><![CDATA[Label]]></text>
            </staticText>
            <staticText>
                <reportElement x="210" y="0" width="90" height="20"/>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="0" width="70" height="20"/>
                <text><![CDATA[Status]]></text>
            </staticText>
            <staticText>
                <reportElement x="370" y="0" width="55" height="20"/>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="425" y="0" width="55" height="20"/>
                <text><![CDATA[Unit]]></text>
            </staticText>
            <staticText>
                <reportElement x="480" y="0" width="55" height="20"/>
                <text><![CDATA[Amount]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="60" height="18"/>
                <textFieldExpression><![CDATA[$F{no}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="60" y="0" width="150" height="18"/>
                <textFieldExpression><![CDATA[$F{label}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="210" y="0" width="90" height="18"/>
                <textFieldExpression><![CDATA[$F{occurredAt}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="0" width="70" height="18"/>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="370" y="0" width="55" height="18"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="425" y="0" width="55" height="18"/>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="480" y="0" width="55" height="18"/>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>

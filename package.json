{
  "name": "metnex",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "turbo:clean": "turbo daemon stop && rm -rf .turbo apps/web/.next/dev apps/web/.next/cache",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.3.0",
      "serialize-javascript": ">=7.0.3",
      "glob": ">=10.5.0",
      "picomatch": ">=4.0.4",
      "fast-uri": ">=4.1.3",
      "postcss": ">=8.5.18",
      "brace-expansion": ">=5.0.9",
      "sharp": ">=0.35.4",
      "fast-xml-builder": ">=1.1.7",
      "tmp": ">=0.2.6",
      "js-yaml": ">=4.3.0",
      "hono": ">=4.12.25",
      "browserslist": ">=4.28.7",
      "nanoid": ">=3.3.18",
      "ip-address": ">=10.3.1",
      "deepmerge-ts": ">=8.0.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "devDependencies": {
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "prettier": "^3.4.2"
  }
}

# Docker Compose — Geliştirme ortamı ortam değişkenleri
# Kullanım: cp .env.example .env
# Bu dosya commit edilir; .env commit edilmez.

POSTGRES_USER=metnex
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=metnex

REDIS_PASSWORD=change_me_dev

MINIO_ROOT_USER=metnex
MINIO_ROOT_PASSWORD=change_me_dev

# Jasper renderer internal token — ./dev.sh generates and persists this here automatically on
# first run; you normally don't need to set it by hand. See docs/runbooks/reporting-foundation.md.
# REPORT_RENDER_INTERNAL_TOKEN=change_me_dev
